# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Required for SafeCheck's AI Security Bot (Google Search grounding).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# WEBRISK_API_KEY: Optional Google Web Risk Lookup API key (server-side only).
# When unavailable or invalid, SafeCheck automatically uses the AI Security Bot + public threat feeds.
WEBRISK_API_KEY=

# CLAMAV_SCANNER_URL: Base URL of the separate ClamAV Cloud Run scanning service.
# Example: https://safecheck-clamav-xxxx.run.app
CLAMAV_SCANNER_URL=

# CLAMAV_SCANNER_TOKEN: Shared bearer secret for authenticating with the ClamAV service.
# Optional only for local development; required in production.
CLAMAV_SCANNER_TOKEN=

# MAX_FILE_SIZE_MB: Maximum allowed uploaded file size in megabytes.
MAX_FILE_SIZE_MB=25

